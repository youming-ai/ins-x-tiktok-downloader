# Build-time config for the split deployment (SPA on a Cloudflare assets-only
# Worker, API on Dokploy). Loaded by `vite build --mode cf` (packages/web
# `build:cf` script → root `build:cf`). This public API origin is baked into the
# static client so the Worker-hosted SPA calls the API cross-origin. Keep
# ALLOWED_ORIGINS on the API in sync with the Worker origin (https://snatch.um1ng.me).
VITE_API_BASE_URL=https://snatch-api.um1ng.me
